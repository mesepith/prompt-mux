# Copy this file to .env and fill in the keys for the providers you want.
# Any provider without a key is shown as "not configured" in the UI.
# The "Demo" provider always works without a key.

PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/promptmux

# Who may create an account. Empty = anyone can sign up, which on a public host means
# strangers can chat on YOUR provider keys and make this server email any address.
# Set it to your own address(es), or a whole domain with a leading @:
#   ALLOWED_EMAILS=me@example.com
#   ALLOWED_EMAILS=me@example.com,@mycompany.com
ALLOWED_EMAILS=

# Branding
APP_NAME=PromptMux

# Auth
JWT_SECRET=change-this-to-a-long-random-string
BCRYPT_ROUNDS=10
OTP_EXPIRY_MINUTES=10

# Anonymous users can send this many messages total before they must sign up or log in.
ANONYMOUS_MESSAGE_LIMIT=3

# SMTP (works with Zoho, Gmail, etc.)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@yourdomain.com
SMTP_SECURE=false

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Moonshot AI (Kimi) — OpenAI-compatible API
MOONSHOT_API_KEY=
# International: https://api.moonshot.ai/v1 | China: https://api.moonshot.cn/v1
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# DeepSeek — OpenAI-compatible API (https://api-docs.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Mistral — OpenAI-compatible API (https://docs.mistral.ai)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Z.ai (GLM) — OpenAI-compatible API (https://docs.z.ai)
ZAI_API_KEY=
# International: https://api.z.ai/api/paas/v4 | China: https://open.bigmodel.cn/api/paas/v4
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
