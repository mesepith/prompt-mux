# Copy this file to .env and fill in the keys for the providers you want.
# Any provider without a key is shown as "not configured" in the UI.
# The "Demo" provider always works without a key.
#
# Provider keys can also be entered in the admin dashboard (/admin), where they are
# encrypted before being stored in MongoDB. A key stored there WINS over the matching
# variable below, so treat these as the fallback / bootstrap path.

PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/promptmux

# Who may create an account. Empty = anyone can sign up, which on a public host means
# strangers can chat on YOUR provider keys and make this server email any address.
# Set it to your own address(es), or a whole domain with a leading @:
#   ALLOWED_EMAILS=me@example.com
#   ALLOWED_EMAILS=me@example.com,@mycompany.com
ALLOWED_EMAILS=

# Who gets the admin dashboard at /admin: LLM companies, models, prices and API keys.
# Exact addresses only, comma-separated — a listed account is promoted to admin the next
# time it signs in. Unlike ALLOWED_EMAILS, EMPTY GRANTS NOBODY: an unset variable must
# never mean "everyone is an admin". Whole-domain rules are deliberately not supported.
#   ADMIN_EMAILS=me@example.com,ops@mycompany.com
# To grant or revoke later without touching this file:
#   npm --prefix server run make-admin -- me@example.com [--revoke]
#   npm --prefix server run make-admin -- --list
ADMIN_EMAILS=

# URL segment the admin dashboard is served from. NOT "admin" — a public host gets
# scanned for /admin within minutes of going up. Leave this empty and the server
# generates a random segment on first boot and stores it in MongoDB; it is printed to
# the log, shown on the dashboard's Settings tab, and returned by GET /api/auth/me to
# admins only, so it never reaches the browser bundle or a non-admin. Set it here to
# choose something you can type. 3-64 chars: letters, digits, dashes, underscores.
#   ADMIN_PATH=my-secret-console      ->  dashboard at /my-secret-console
# This is defence in depth, not the lock: every request under it still verifies that
# the caller is a signed-in administrator, and a wrong segment returns a plain 404.
ADMIN_PATH=

# Encrypts provider API keys entered in the admin dashboard (AES-256-GCM) before they are
# written to MongoDB — without it a Mongo dump or backup hands over every paid credential.
# Generate one with:  openssl rand -hex 32
# If left empty the key is DERIVED FROM JWT_SECRET so existing installs keep working; the
# catch is that rotating JWT_SECRET then makes every stored provider key unreadable (keys
# in this file keep working, dashboard-stored ones must be re-entered). Set it explicitly.
ENCRYPTION_KEY=

# Fallback model used to read pricing pages when the dashboard's Settings tab doesn't name
# one. Must be a model id from the registry, on a company that has a working key — a cheap
# long-context model is ideal, and it never takes part in a user's conversation.
#   ADMIN_LLM_MODEL=mistral-small-4
ADMIN_LLM_MODEL=

# LOCAL DEVELOPMENT ONLY. The price fetcher refuses private, loopback and link-local
# addresses because the server fetches an admin-supplied URL — that is an SSRF sink with
# reach into cloud metadata, MongoDB on localhost and anything else on the box. Setting
# this to 1 disables that guard so you can point it at a fixture file on 127.0.0.1.
# NEVER set it on a deployed server.
ADMIN_FETCH_ALLOW_PRIVATE=

# Branding
APP_NAME=PromptMux

# Auth
JWT_SECRET=change-this-to-a-long-random-string
BCRYPT_ROUNDS=10
OTP_EXPIRY_MINUTES=10

# Anonymous users can send this many messages total before they must sign up or log in.
ANONYMOUS_MESSAGE_LIMIT=3

# SMTP (works with Zoho, Gmail, etc.)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@yourdomain.com
SMTP_SECURE=false

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Moonshot AI (Kimi) — OpenAI-compatible API
MOONSHOT_API_KEY=
# International: https://api.moonshot.ai/v1 | China: https://api.moonshot.cn/v1
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# DeepSeek — OpenAI-compatible API (https://api-docs.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Mistral — OpenAI-compatible API (https://docs.mistral.ai)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Z.ai (GLM) — OpenAI-compatible API (https://docs.z.ai)
ZAI_API_KEY=
# International: https://api.z.ai/api/paas/v4 | China: https://open.bigmodel.cn/api/paas/v4
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
