# Copy this file to .env and fill in the keys for the providers you want.
# Any provider without a key is shown as "not configured" in the UI.
# The "Demo" provider always works without a key.

PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/promptmux

# Shared password for the whole app (HTTP Basic). There are no user accounts, so
# this is what keeps a reachable host from serving your chats — including text
# extracted from uploaded PDFs — to anyone who asks.
#
# Leave it EMPTY if either is true:
#   - local-only laptop setup, or
#   - a proxy in front already requires a password (nginx auth_basic / .htaccess,
#     a VPN) and this port isn't reachable directly.
# If you DO have proxy auth and still want app-level auth (defence in depth, e.g.
# other sites share the host), set these to the SAME user and password the proxy
# uses: nginx forwards the Authorization header on, so different credentials make
# the app reject every request.
# Use TLS (deploy/nginx.conf + certbot) either way — Basic sends it on every request.
APP_USER=promptmux
APP_PASSWORD=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Moonshot AI (Kimi) — OpenAI-compatible API
MOONSHOT_API_KEY=
# International: https://api.moonshot.ai/v1 | China: https://api.moonshot.cn/v1
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# DeepSeek — OpenAI-compatible API (https://api-docs.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Mistral — OpenAI-compatible API (https://docs.mistral.ai)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Z.ai (GLM) — OpenAI-compatible API (https://docs.z.ai)
ZAI_API_KEY=
# International: https://api.z.ai/api/paas/v4 | China: https://open.bigmodel.cn/api/paas/v4
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
